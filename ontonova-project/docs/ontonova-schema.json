{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OntoNovaIntermediateSchema",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "ontology_name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["ontology_name"]
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
          "label": { "type": "string" },
          "subClassOf": { "type": ["string", "null"], "description": "ID de la clase padre si existe" },
          "description": { "type": "string" }
        },
        "required": ["id", "label"]
      }
    },
    "object_properties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
          "label": { "type": "string" },
          "domain": { "type": "string", "description": "ID de la clase origen" },
          "range": { "type": "string", "description": "ID de la clase destino" },
          "characteristics": {
            "type": "array",
            "items": { 
              "type": "string", 
              "enum": ["Functional", "InverseFunctional", "Transitive", "Symmetric", "Asymmetric", "Reflexive", "Irreflexive"] 
            }
          }
        },
        "required": ["id", "label", "domain", "range"]
      }
    },
    "data_properties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
          "label": { "type": "string" },
          "domain": { "type": "string" },
          "range": { 
            "type": "string", 
            "enum": ["xsd:string", "xsd:integer", "xsd:float", "xsd:boolean", "xsd:dateTime"] 
          }
        },
        "required": ["id", "label", "domain", "range"]
      }
    },
    "individuals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
          "label": { "type": "string" },
          "type": { "type": "string", "description": "ID de la Clase a la que pertenece" },
          "object_property_assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "property_id": { "type": "string" },
                "target_individual_id": { "type": "string" }
              },
              "required": ["property_id", "target_individual_id"]
            }
          },
          "data_property_assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "property_id": { "type": "string" },
                "value": { "type": ["string", "number", "boolean"] }
              },
              "required": ["property_id", "value"]
            }
          }
        },
        "required": ["id", "label", "type"]
      }
    }
  },
  "required": ["metadata", "classes", "object_properties", "data_properties", "individuals"]
}