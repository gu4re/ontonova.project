# Python venv artifacts not caught by the repo-root .gitignore (which only
# ignores **/lib/, **/bin/, **/include/, not lib64 or pyvenv.cfg).
lib64
pyvenv.cfg

# Node
node_modules/

# The repo-root .gitignore blanket-ignores *.svg/*.png (meant for generated
# thesis figures) and .env.* (meant for real secrets/local overrides), but
# these are legitimate tracked application files — re-include them.
!.env.example
!frontend/public/*.svg
!frontend/public/*.png
# The repo-root .gitignore blanket-ignores *.pdf (thesis output), but this is
# a test fixture the okapi full-stack e2e depends on.
!frontend/e2e/fixtures/*.pdf

# Generated acceptance-test artifacts (regenerated by running the tests)
backend/api/acceptance-tests/**/*-report.json
frontend/e2e/okapi-captured-graph.json
