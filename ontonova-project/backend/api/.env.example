# Base URL of the vLLM OpenAI-compatible server(s), see backend/llm-server/main.sh.
# Each agent role can point at a different model/instance for true multi-model
# orchestration; default them all to the same local server for a single-GPU setup.
TAXONOMIST_BASE_URL=http://localhost:8000/v1
RELATIONAL_BASE_URL=http://localhost:8000/v1
POPULATOR_BASE_URL=http://localhost:8000/v1

LLM_MODEL_NAME=Qwen/Qwen3-14B-AWQ
# Dense domain texts can need a large guided-JSON completion; a 14B model at
# ~75 tok/s can legitimately take minutes for one agent's turn.
LLM_REQUEST_TIMEOUT_SECONDS=300

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173
